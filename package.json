{
  "name": "dsh-paper-reader",
  "version": "0.7.1",
  "description": "Read PDFs beside a DSH conversation, quote selected passages, and generate discussion-based reading notes",
  "author": "Jingyi HUANG <2270737347@qq.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pierre1231/dsh-paper-reader.git"
  },
  "homepage": "https://github.com/Pierre1231/dsh-paper-reader#readme",
  "bugs": "https://github.com/Pierre1231/dsh-paper-reader/issues",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "pdf",
    "paper",
    "reader",
    "reading-notes"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-input-trigger",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-sidebar-documentpreview"
      ]
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "PDFJS-LICENSE",
    "PDFJS-CMAP-LICENSE",
    "PDFJS-FONT-FOXIT-LICENSE",
    "PDFJS-FONT-LIBERATION-LICENSE"
  ],
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/browser-e2e.mjs",
    "test:visual": "node tests/visual-e2e.mjs",
    "test:capture": "node tests/capture-e2e.mjs",
    "test:auto-send": "node tests/auto-send-e2e.mjs",
    "test:scroll": "node tests/scroll-e2e.mjs",
    "test:perf": "node tests/scroll-perf.mjs",
    "test:parity": "node tests/textlayer-parity-e2e.mjs",
    "test:formula": "node tests/formula-selection-e2e.mjs",
    "test:features": "node tests/reader-features-e2e.mjs",
    "test:hover": "node tests/hover-timing-e2e.mjs",
    "test:scenarios": "node tests/host-scenarios.mjs",
    "test:stress": "node tests/host-stress.mjs"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "esbuild": "^0.25.0",
    "pdfjs-dist": "^4.10.38",
    "playwright-core": "^1.64.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.8.3"
  },
  "peerDependencies": {
    "react": "^18.2.0"
  }
}
